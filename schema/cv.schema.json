{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cv-builder CV (format 1.0.0)",
  "description": "CV document: JSON Resume v1.0.0 compatible, with cv-builder extensions (achievements, education location/highlights, language rating, layout).",
  "$defs": {
    "Achievement": {
      "additionalProperties": false,
      "description": "Extension: a highlighted accomplishment.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Icon name, e.g. gem, star, award, zap, target.",
          "title": "Icon"
        }
      },
      "required": [
        "title"
      ],
      "title": "Achievement",
      "type": "object"
    },
    "Award": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "awarder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Awarder"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "title"
      ],
      "title": "Award",
      "type": "object"
    },
    "Basics": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Headline shown under the name.",
          "title": "Label"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Photo: path relative to the JSON file, or a URL.",
          "title": "Image"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personal website.",
          "title": "Url"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short bio; blank lines separate paragraphs.",
          "title": "Summary"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/Profile"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Basics",
      "type": "object"
    },
    "Certificate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certificate",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startdate"
        },
        "endDate": {
          "anyOf": [
            {
              "description": "End date, or \"present\". Omit for ongoing entries (prints \"Present\"); set equal to startDate to print a single date.",
              "examples": [
                "2022-06",
                "present"
              ],
              "pattern": "^([Pp]resent|\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enddate"
        },
        "institution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field of study, e.g. Computer Science.",
          "title": "Area"
        },
        "studyType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Degree, e.g. Master, Bachelor.",
          "title": "Studytype"
        },
        "score": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "courses": {
          "items": {
            "type": "string"
          },
          "title": "Courses",
          "type": "array"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extension: where the school is.",
          "title": "Location"
        },
        "highlights": {
          "description": "Extension: bullet points.",
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        }
      },
      "title": "Education",
      "type": "object"
    },
    "HeaderLayout": {
      "additionalProperties": false,
      "properties": {
        "contacts": {
          "description": "Contact fields shown in the header, in order.",
          "items": {
            "enum": [
              "phone",
              "email",
              "url",
              "location"
            ],
            "type": "string"
          },
          "title": "Contacts",
          "type": "array"
        },
        "profiles": {
          "description": "basics.profiles networks shown in the header (case-insensitive). The remaining profiles go to the 'profiles' section.",
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "photo": {
          "default": true,
          "description": "Show basics.image when set.",
          "title": "Photo",
          "type": "boolean"
        }
      },
      "title": "HeaderLayout",
      "type": "object"
    },
    "Interest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Interest",
      "type": "object"
    },
    "Language": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "title": "Language",
          "type": "string"
        },
        "fluency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. Native, Fluent, B1.",
          "title": "Fluency"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extension: 0-5 dots. Inferred from fluency (CEFR or words) when omitted.",
          "title": "Rating"
        }
      },
      "required": [
        "language"
      ],
      "title": "Language",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "Extension: how the CV is presented. Every field is optional.",
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template name (`cv-builder templates` lists them: clear, classic, compact, modern, sidebar, timeline) or a template directory. The former names two-column and single-column still work.",
          "title": "Template"
        },
        "pageSize": {
          "anyOf": [
            {
              "enum": [
                "A4",
                "Letter"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagesize"
        },
        "maxPages": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page limit. A CV that runs over gets tighter line spacing until it fits, never below 1.15; text size and margins never change. If that is not enough, the build warns how many lines are too many.",
          "title": "Maxpages"
        },
        "accentColor": {
          "anyOf": [
            {
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hex color, e.g. #1E90FF.",
          "title": "Accentcolor"
        },
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "enum": [
                    "summary",
                    "work",
                    "volunteer",
                    "education",
                    "projects",
                    "skills",
                    "languages",
                    "achievements",
                    "awards",
                    "certificates",
                    "publications",
                    "interests",
                    "references",
                    "profiles"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section order per template column, e.g. {\"left\": [\"work\", \"education\"], \"right\": [\"summary\", \"skills\"]} for compact or {\"main\": [\"summary\", \"work\", \"education\", \"skills\"]} for clear. Sections left out are not rendered.",
          "title": "Columns"
        },
        "titles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Section title overrides.",
          "propertyNames": {
            "enum": [
              "summary",
              "work",
              "volunteer",
              "education",
              "projects",
              "skills",
              "languages",
              "achievements",
              "awards",
              "certificates",
              "publications",
              "interests",
              "references",
              "profiles"
            ]
          },
          "title": "Titles",
          "type": "object"
        },
        "header": {
          "$ref": "#/$defs/HeaderLayout"
        },
        "documentTitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF document title metadata.",
          "title": "Documenttitle"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The CV's language, a BCP-47 tag such as en, fr or de: headings, month names and \"Present\" follow it (English, French and German in full; month names for any other).",
          "title": "Language"
        },
        "dateStyle": {
          "anyOf": [
            {
              "enum": [
                "month",
                "numeric"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Months as names (Mar 2021) or numbers (03/2021). Default: numbers in German, names otherwise.",
          "title": "Datestyle"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "postalCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postalcode"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State, province or country name.",
          "title": "Region"
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2 code, e.g. DE.",
          "title": "Countrycode"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": true,
      "properties": {
        "canonical": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "lastModified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastmodified"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "description": "e.g. LinkedIn, GitHub, Hugging Face.",
          "title": "Network",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "network"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startdate"
        },
        "endDate": {
          "anyOf": [
            {
              "description": "End date, or \"present\". Omit for ongoing entries (prints \"Present\"); set equal to startDate to print a single date.",
              "examples": [
                "2022-06",
                "present"
              ],
              "pattern": "^([Pp]resent|\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enddate"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "Publication": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "releaseDate": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Releasedate"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "name"
      ],
      "title": "Publication",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "name"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Skill group name, e.g. Systems Programming.",
          "title": "Name",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Skill",
      "type": "object"
    },
    "TitleSpan": {
      "additionalProperties": false,
      "description": "Extension: one title held during a role.",
      "properties": {
        "startDate": {
          "anyOf": [
            {
              "description": "ISO 8601 date with year, month or day precision.",
              "examples": [
                "2019",
                "2019-07",
                "2019-07-15"
              ],
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
